# ============================================================
# Financial News Agent - Environment Variables
# ============================================================
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to git (it is gitignored).
# ============================================================

# --- News Source ---
# Get a free key at https://newsdata.io
NEWSDATA_API_KEY=

# --- HuggingFace (FinBERT inference) ---
# Create a read token at https://huggingface.co/settings/tokens
HF_API_TOKEN=

# --- OpenRouter (LLMs: DeepSeek + Grok) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- OpenAI (embeddings, Whisper, TTS) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Pinecone (vector store) ---
# Get a key at https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=fin-news-documents

# --- MongoDB (article history + chat memory) ---
# Connection string from https://cloud.mongodb.com
MONGO_URI=
MONGO_DB=fin-news-db

# --- Telegram (bot delivery + conversational trigger) ---
# Create a bot with @BotFather and get your chat id with @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Model selection (OpenRouter model ids) ---
MODEL_SUB_AGENT=deepseek/deepseek-v4-flash
MODEL_MAIN_AGENT=x-ai/grok-4.3
MODEL_EXTRACTOR=deepseek/deepseek-v4-flash

# --- Behaviour ---
# When DRY_RUN=true the pipeline does not send Telegram messages
# and does not persist into Pinecone or MongoDB. Safe for demos.
DRY_RUN=true
